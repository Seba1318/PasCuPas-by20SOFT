# Copiați în .env și completați. .env nu intră niciodată în Git.
DATABASE_URL=postgresql+psycopg://navigare:navigare@localhost:5432/navigare
# Generați cu: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com
UPLOAD_DIR=./uploads
# Verificarea pozelor cu Claude: fără cheie, rapoartele rămân „neverificat” (30 de puncte).
# AI_MODEL gol = claude-opus-5-5; pentru cost mai mic se poate pune claude-haiku-5-5.
AI_API_KEY=
AI_MODEL=
# Câte poze verifică modelul pe zi (plafon de cost); peste el, rapoartele rămân „neverificat”.
AI_DAILY_LIMIT=50
NOMINATIM_USER_AGENT=20soft-navigare/1.0 (emailul echipei)
DEMO_BBOX=21.2150,45.7380,21.2480,45.7560

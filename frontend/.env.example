# Copiați în frontend/.env.local și completați. Fișierele .env.* nu intră în Git.

# true = frontendul răspunde din src/api/mock, fără backend (date de exemplu, cu banda „Mod demo”).
# false = vorbește cu API-ul FastAPI.
VITE_USE_MOCKS=false

# /api = prin proxy-ul Vite spre backend (vezi vite.config.js): un singur tunel HTTPS ajunge
# pentru testul pe telefon și nu e nevoie de CORS. Altfel, adresa completă: http://localhost:8000
VITE_API_URL=/api

# Zona demo, aceeași ca DEMO_BBOX din .env-ul backendului: minLon,minLat,maxLon,maxLat
VITE_DEMO_BBOX=21.2150,45.7380,21.2480,45.7560

# Opțional: alt furnizor de tile-uri (gol = OpenStreetMap; tema întunecată folosește un filtru CSS).
VITE_TILE_URL=
VITE_TILE_URL_DARK=
VITE_TILE_ATTRIBUTION=
